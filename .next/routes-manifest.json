{
  "version": 3,
  "pages404": true,
  "appType": "app",
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "priority": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "onMatchHeaders": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/api/atividades/[id]",
      "regex": "^/api/atividades/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/atividades/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/customizacoes/[id]",
      "regex": "^/api/customizacoes/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
