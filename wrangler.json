{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cs-controle360",
  "main": ".vercel/output/static/_worker.js",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "build": {
    "command": "npx @cloudflare/next-on-pages"
  },
  "assets": {
    "binding": "ASSETS",
    "directory": ".vercel/output/static"
  }
}
